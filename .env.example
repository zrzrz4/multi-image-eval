# Copy to .env and fill in locally (never commit .env)

# Judge / Gemini-compatible API (required for eval)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3-flash-preview

# Default generation model directory
FIRERED_MODEL_PATH=/path/to/your/FireRed-Image-Edit-1.1

# Console port
VIEWER_PORT=8765

# Optional: Python for GPU generation subprocess
# MULTI_IMAGE_EVAL_PYTHON=/path/to/python

# Optional: Edit-Compass Part5 external project root
# EDIT_COMPASS_ROOT=/path/to/Edit-Compass Part5
# EDIT_COMPASS_PYTHON=/path/to/edit-compass/.venv/bin/python

# Optional: shared read-only results archive
# MIE_PUBLIC_RESULTS=/path/to/shared/results

# HuggingFace (optional)
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=
# HF_HFD_THREADS=10
# HF_DOWNLOAD_WORKERS=16
